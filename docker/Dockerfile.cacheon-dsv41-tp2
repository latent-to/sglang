# The lmsysorg/sglang nightly built at this branch's upstream base, with this branch's package on top.
# The whole package is copied, not a list of files: the tree differs from the parent's only by this
# branch's commits, and the per-file list had not followed the commits after the first.
FROM lmsysorg/sglang@sha256:8346c975515af7ec6b2692faadd5332f789001f78f958335175d4d34e170537c
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/latent-to/sglang"
LABEL org.opencontainers.image.revision="$SOURCE_REVISION"
COPY python/sglang /sgl-workspace/sglang/python/sglang
